{
  "name": "@grinev/stepan",
  "version": "0.1.0",
  "description": "CLI for agent workflows: the agent pulls the next step, the CLI holds the flow.",
  "license": "MIT",
  "author": "Ruslan Grinev",
  "type": "module",
  "bin": {
    "stepan": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grinev/stepan.git"
  },
  "homepage": "https://github.com/grinev/stepan#readme",
  "bugs": {
    "url": "https://github.com/grinev/stepan/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "agents",
    "workflows",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:notes:preview": "node scripts/release-notes-preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
